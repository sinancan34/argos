{
  "google_analytics": {
    "name": "Google Analytics",
    "urlPatterns": [
      "^https?://[^/]+/g/collect"
    ],
    "paramConstraints": [
      { "key": "v", "match": "exact", "value": "2" },
      { "key": "tid", "match": "startsWith", "value": "G-" }
    ],
    "paramSuggestions": [
      {
        "label": "event_name",
        "value": "en",
        "valueSuggestions": [
          "page_view",
          "view_phone"
        ]
      }
    ]
  }
}